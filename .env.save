# OpenAI Configuration - Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# OR Use Ollama (local) - Uncomment these lines to use Ollama instead
# USE_OLLAMA=true
# OLLAMA_MODEL=llama3.1
# OLLAMA_API_URL=http://localhost:11434/api/generate

# Flask Configuration
FLASK_DEBUG=false
SECRET_KEY=dev-secret-key-please-change

# Java Testing - Download JUnit from:
# https://repo1.maven.org/maven2/org/junit/platform/junit-platform-console-standalone/1.10.2/junit-platform-console-standalone-1.10.2.jar
# Set the path to the downloaded JAR
JUNIT_JAR=/path/to/junit-platform-console-standalone-1.10.2.jar

# Port
PORT=5000
