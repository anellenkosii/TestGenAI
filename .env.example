# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real API keys.

# --- OpenAI (cloud) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# --- OR Ollama (local, free) — set USE_OLLAMA=true to use this instead ---
USE_OLLAMA=false
OLLAMA_MODEL=llama3.1
OLLAMA_API_URL=http://localhost:11434/api/generate

# --- Flask ---
# Keep FLASK_DEBUG=false unless you're actively developing locally.
FLASK_DEBUG=false
SECRET_KEY=change-me-to-a-random-value
PORT=5002

# --- Java testing (optional) ---
# Path to junit-platform-console-standalone-1.10.2.jar, see README.
JUNIT_JAR=/path/to/junit-platform-console-standalone-1.10.2.jar
